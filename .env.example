# Database Configuration
# ---------------------
# Host and port of your PostgreSQL server
DB_HOST=localhost
DB_PORT=5432

# Name of the database to create/use
DB_NAME=job_market_db

# Regular database user (for the application)
DB_USER=postgres
DB_PASSWORD=your_password_here

# Superuser credentials (only needed for database creation)
# If not provided, DB_USER/DB_PASSWORD will be used
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=your_password_here

# Application Settings
DEBUG=False
LOG_LEVEL=INFO